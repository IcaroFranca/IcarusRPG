<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.icaro</groupId>
  <artifactId>icarusrpg</artifactId>
  <version>0.64.3</version>
  <packaging>jar</packaging>

  <name>IcarusRPG</name>
  <description>RPG gameplay plugin for Paper/Spigot Minecraft servers.</description>

  <properties>
    <!-- paper-api 26.2 ships class files built with Java 25 (class file
         version 69); the compiler release below must match or newer. -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Matches the api-version declared in plugin.yml (Paper's post-1.21
         calendar-based versioning: MC 26.2). Bump the build number to the
         latest stable at https://repo.papermc.io/repository/maven-public/io/papermc/paper/paper-api/maven-metadata.xml -->
    <paper.api.version>26.2.build.119-stable</paper.api.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>enginehub</id>
      <url>https://maven.enginehub.org/repo/</url>
    </repository>
    <repository>
      <id>citizens-repo</id>
      <url>https://maven.citizensnpcs.co/repo</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Optional soft-depend: ProtectionService talks to WorldGuard's (and
         transitively WorldEdit's) API directly at compile time, so it needs
         this even though the plugin only hooks in when WorldGuard is
         actually installed on the server. Transitive deps (worldguard-core,
         worldedit-core, worldedit-bukkit) are needed too - don't exclude them. -->
    <dependency>
      <groupId>com.sk89q.worldguard</groupId>
      <artifactId>worldguard-bukkit</artifactId>
      <version>7.0.13</version>
      <scope>provided</scope>
    </dependency>
    <!-- GUI toolkit for inventory menus (Skills, Bestiary, Mineração, Cores de
         Nível...). Not a server plugin like WorldGuard - nothing provides it
         at runtime, so it's shaded (and relocated) into our own jar below
         instead of being "provided". Pinned to 0.12.0, NOT the latest 0.12.1:
         0.12.1 added click/drag/close annotation processing to the Gui
         constructor (Gui#processMethodAnnotations) that unconditionally reads
         method.getParameterTypes()[0] for every declared method on the class,
         throwing ArrayIndexOutOfBoundsException the instant you construct
         *any* Gui - ChestGui itself declares plenty of 0-parameter methods
         (copy(), getRows()...), so this crashes whether or not you use the
         annotations at all. Confirmed still present on IF's master as of
         2026-08-28; bump past 0.12.1 once upstream ships a fix. -->
    <dependency>
      <groupId>com.github.stefvanschie.inventoryframework</groupId>
      <artifactId>IF</artifactId>
      <version>0.12.0</version>
    </dependency>
    <!-- Optional soft-depend, same story as WorldGuard above: CitizensIntegrationService
         talks to Citizens' NPC API directly at compile time so it needs this, but the
         plugin only spawns Citizens NPCs when Citizens is actually installed. Citizens
         itself is free and open-source (github.com/CitizensDev/Citizens2) despite also
         being listed as a "pay what you want" resource on SpigotMC - either build works,
         no feature is gated behind payment. -->
    <!-- citizens-main (not just citizensapi) - concrete trait classes like SkinTrait
         live in net.citizensnpcs.trait, which only ships in the full plugin jar. -->
    <dependency>
      <groupId>net.citizensnpcs</groupId>
      <artifactId>citizens-main</artifactId>
      <version>2.0.43-SNAPSHOT</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Sentinel: Citizens add-on that gives NPCs combat AI (targeting, chasing,
         attacking) out of the box, so custom mobs don't need hand-written pathing.
         Also free/open-source (github.com/mcmonkeyprojects/Sentinel). -->
    <dependency>
      <groupId>org.mcmonkey</groupId>
      <artifactId>sentinel</artifactId>
      <version>2.9.4-SNAPSHOT</version>
      <type>jar</type>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.name}-${project.version}</finalName>
    <defaultGoal>package</defaultGoal>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <!-- Shades IF into our jar (it isn't a server plugin, so nothing else
           provides it at runtime) and relocates its package so it can't
           clash with a different IF version shaded by some other plugin on
           the same server. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <relocations>
                <relocation>
                  <pattern>com.github.stefvanschie.inventoryframework</pattern>
                  <shadedPattern>dev.icaro.foodtooltips.libs.inventoryframework</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
